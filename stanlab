#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$project_dir"
command="${1:-help}"
shift || true

require_config() {
  if [[ ! -f .env ]]; then
    echo 'Stanlab: copy .env.example to .env and set the Compose port and Docker network first.' >&2
    exit 1
  fi
  if [[ ! -f config/stanlab.env ]]; then
    echo 'Stanlab: run ./stanlab setup to create credentials, then configure config/stanlab.env.' >&2
    exit 1
  fi
}

case "$command" in
  help|-h|--help)
    cat <<'HELP'
Stanlab Dash

Usage: ./stanlab <command>

Commands:
  setup                    Create or reset the single-user login credentials
  install                  Build and start the manually configured Compose project
  up                       Same as install
  start                    Start the existing Compose container
  stop                     Stop Stanlab
  restart                  Restart Stanlab
  status                   Show Compose status
  logs [--follow]          Show recent logs, or follow them
  uninstall                Remove Stanlab containers; keep configuration and data
  help                     Show this help

Edit .env and config/stanlab.env yourself. This CLI does not select ports,
discover Docker networks, install host services, or configure DNS or tunnels.
HELP
    ;;
  setup)
    docker run --rm --interactive --tty --user "$(id -u):$(id -g)" \
      --env "USER=$(id -un)" --volume "$project_dir:/app" --workdir /app node:24-alpine \
      node scripts/setup-auth.mjs
    echo 'Review config/stanlab.env, then run docker compose up -d --build.'
    ;;
  install|up)
    require_config
    docker compose up --detach --build "$@"
    ;;
  start)
    require_config
    docker compose start "$@"
    ;;
  stop)
    require_config
    docker compose stop "$@"
    ;;
  restart)
    require_config
    docker compose restart "$@"
    ;;
  status)
    require_config
    docker compose ps "$@"
    ;;
  logs)
    require_config
    if [[ " ${*:-} " == *" --follow "* || " ${*:-} " == *" -f "* ]]; then
      docker compose logs --follow
    else
      docker compose logs --tail 100 "$@"
    fi
    ;;
  uninstall)
    require_config
    docker compose down "$@"
    echo 'Stanlab containers removed. The stanlab-data volume and configuration were kept.'
    ;;
  *)
    echo "Stanlab: unknown command '$command'. Run ./stanlab help for available commands." >&2
    exit 2
    ;;
esac
