NODE_ENV=development
DASH_DEPLOYMENT_MODE=
DASH_ORIGIN=http://localhost:5173
DASH_USERNAME=stanly
# Credentials are written by `./stanlab install` or `./stanlab setup`.
DASH_PASSWORD_HASH=
# Keep false for local HTTP development. Set true behind HTTPS in production.
DASH_COOKIE_SECURE=false
SESSION_STORE=memory
REDIS_URL=
DASH_DOCKER_NETWORK=
DASH_COMPOSE_DIR=
DASH_UID=
DASH_GID=
DASH_HOST_AGENT_DIR=
# Optional host-validated command capability. Exact operations are fixed in code.
DASH_GDM_ENABLED=false
