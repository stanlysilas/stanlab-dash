NODE_ENV=production
DASH_ORIGIN=https://stanlab.dpdns.org
DASH_HOSTNAME=Legion
DASH_USERNAME=
DASH_PASSWORD_HASH=
DASH_COOKIE_SECURE=true
SESSION_STORE=redis
REDIS_URL=redis://nextcloud-redis:6379/1
# Host display-manager controls stay disabled in a regular Docker deployment.
DASH_GDM_ENABLED=false
